load("//tools/lint:defs.bzl", "comment_srcs")

# Exported flat so the macOS app bundles it as `Contents/Resources/init.lua`, where
# `Bundle.main.path(forResource:"init", ofType:"lua")` resolves it.
exports_files(
    ["init.lua"],
    visibility = ["//visibility:public"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
