# assertions are gone (that path was removed with the per-window-tabs change).
# Drives a REAL pinned Neovim (no mocks), stages the captive `init.lua` + the
# pinned nvim tree as runfiles, reuses `tests/common/mod.rs`, and runs unsandboxed
# so the nvim child can spawn.
rust_test(
    name = "empty_state_cwd",
    srcs = [
        "tests/common/mod.rs",
        "tests/empty_state_cwd.rs",
    ],
    crate_root = "tests/empty_state_cwd.rs",
    # Spawning a real nvim child does not work under the macOS build sandbox, so
    # run unsandboxed. `no-sandbox` (vs `local`) keeps Bazel test-result caching.
    tags = ["no-sandbox"],
    size = "small",
    edition = "2021",
    data = [
        "//bazel/nvim:nvim_tree",
        "//runtime/nvim:init.lua",
    ],
    env = {
        "WOLF_NVIM_BIN": "$(rootpath //bazel/nvim:nvim_tree)/nvim/bin/nvim",
        "WOLF_TEST_INIT_LUA": "$(rootpath //runtime/nvim:init.lua)",
        "WOLF_TEST_NVIM_DIR": "$(rootpath //bazel/nvim:nvim_tree)",
    },
    deps = [":wolf_core"] + all_crate_deps(normal = True, normal_dev = True),
)

