# Bazel build for the GUI-free `wolf-core` crate; deps come from the Cargo workspace via
# crate_universe. See notes/wolf-core-decisions.md#the-one-hard-rule
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools/lint:defs.bzl", "comment_srcs")

exports_files(["Cargo.toml"])

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)

# The in-module `#[cfg(test)]` unit tests: pure, so no runfiles and no `no-sandbox` tag.
rust_test(
    name = "wolf_core_lib_test",
    crate = ":wolf_core",
    size = "small",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    deps = all_crate_deps(normal = True, normal_dev = True),
)

rust_library(
    name = "wolf_core",
    srcs = glob(["src/**/*.rs"]),
    # Every file a module include_str!'s: one outside these globs compiles under Cargo but
    # fails under Bazel.
    compile_data = glob([
        "src/markdown/**/*.css",
        "src/markdown/assets/*.b64",
        "src/markdown/assets/*.txt",
        "src/licenses/*.txt",
    ]),
    crate_name = "wolf_core",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

# Real-nvim targets stage the pinned nvim tree and init.lua as runfiles, which
# tests/common/mod.rs resolves to absolute paths.
rust_test(
    name = "file_search",
    srcs = [
        "tests/common/mod.rs",
        "tests/file_search.rs",
    ],
    crate_root = "tests/file_search.rs",
    # Spawning a real nvim child does not work under the macOS build sandbox, so
    # run unsandboxed. `no-sandbox` (vs `local`) keeps Bazel test-result caching.
    tags = ["no-sandbox"],
    size = "small",
    edition = "2021",
    data = [
        "//bazel/nvim:nvim_tree",
        "//runtime/nvim:init.lua",
    ],
    env = {
        # The harness trusts WOLF_NVIM_BIN only when absolute, so it ignores this relative value.
        # See crates/wolf-core/tests/README.md#the-shared-harness--commonmodrs
        "WOLF_NVIM_BIN": "$(rootpath //bazel/nvim:nvim_tree)/nvim/bin/nvim",
        "WOLF_TEST_INIT_LUA": "$(rootpath //runtime/nvim:init.lua)",
        "WOLF_TEST_NVIM_DIR": "$(rootpath //bazel/nvim:nvim_tree)",
    },
    # `normal = True` too: crate_universe drops tempfile, both a normal and a dev dep, from the
    # dev map.
    deps = [":wolf_core"] + all_crate_deps(normal = True, normal_dev = True),
)

