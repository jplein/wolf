# Bazel build for the `wolf-ffi` swift-bridge surface over `wolf-core`.
# swift-bridge stays in this crate's graph; see notes/wolf-ffi-decisions.md#containment
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_static_library", "rust_test")
load("@build_bazel_rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("//tools/lint:defs.bzl", "comment_srcs")

exports_files(["Cargo.toml"])

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs(exclude = ["generated/**"])

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        exclude = ["generated/**"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)

# The committed swift-bridge Swift glue (Foundation-only), compiled into the Swift front-end's
# `wolf_key_map` module.
filegroup(
    name = "generated_swift",
    srcs = [
        "generated/SwiftBridgeCore.swift",
        "generated/wolf-ffi.swift",
    ],
    visibility = ["//visibility:public"],
)

# rust_library builds the rlib the Rust tests link; rust_static_library builds the app's
# libwolf_ffi.a.
_WOLF_FFI_DEPS = [
    "//crates/wolf-core:wolf_core",
    "@crates//:swift-bridge",
    "@crates//:tracing",
]

rust_library(
    name = "wolf_ffi",
    srcs = ["src/lib.rs"],
    crate_name = "wolf_ffi",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = _WOLF_FFI_DEPS,
)

rust_static_library(
    name = "wolf_ffi_staticlib",
    srcs = ["src/lib.rs"],
    crate_name = "wolf_ffi",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = _WOLF_FFI_DEPS,
)

# C interface for Swift: committed headers + wake header, linking the staticlib. The hint uses
# the committed module map, so `WolfFFI` has the same layout under Bazel and Xcode/SwiftPM.
swift_interop_hint(
    name = "wolf_ffi_cc_hint",
    module_map = "generated/module.modulemap",
    module_name = "WolfFFI",
)

cc_library(
    name = "wolf_ffi_cc",
    hdrs = glob(["generated/*.h"]) + ["generated/module.modulemap"],
    aspect_hints = [":wolf_ffi_cc_hint"],
    includes = ["generated"],
    visibility = ["//visibility:public"],
    deps = [":wolf_ffi_staticlib"],
)

rust_binary(
    name = "gen_bindings",
    srcs = ["src/bin/gen_bindings.rs"],
    edition = "2021",
    visibility = ["//visibility:private"],
    deps = ["@crates//:swift-bridge-build"],
)

rust_test(
    name = "bridge_smoke",
    srcs = [
        "tests/bridge_smoke.rs",
        "tests/common/mod.rs",
    ],
    crate_root = "tests/bridge_smoke.rs",
    # Spawning nvim fails under the macOS build sandbox. `no-sandbox` (vs `local`) keeps result
    # caching, which is keyed on the staged nvim/init.lua inputs.
    tags = ["no-sandbox"],
    # Bounded by two 10s FLUSH_TIMEOUTs + nvim startup; runs in ~0.2s.
    size = "small",
    edition = "2021",
    # Stage init.lua: under Bazel `CARGO_MANIFEST_DIR` is an ephemeral sandbox path, and nvim
    # without a readable init blocks forever on a "Press ENTER" prompt.
    data = [
        "//bazel/nvim:nvim_tree",
        "//runtime/nvim:init.lua",
    ],
    env = {
        "WOLF_TEST_INIT_LUA": "$(rootpath //runtime/nvim:init.lua)",
        "WOLF_TEST_NVIM_DIR": "$(rootpath //bazel/nvim:nvim_tree)",
    },
    deps = [":wolf_ffi"] + all_crate_deps(normal_dev = True),
)

