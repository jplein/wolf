# Bazel build for the `wolf-ffi` swift-bridge surface over `wolf-core`.
#
# Targets:
#   - wolf_ffi            : the staticlib + rlib the macOS app and the Rust test link.
#   - wolf_ffi_cc         : a cc_library exposing the committed generated C headers
#                           (+ the hand-written wake header) and linking the archive,
#                           consumed by the Swift `swift_library` targets.
#   - gen_bindings        : standalone swift-bridge codegen (run via `bazel run`).
#   - bridge_smoke        : the Rust integration test (rlib-linked; loud-skips when
#                           WOLF_NVIM_BIN is unset).
#
# swift-bridge is confined to THIS crate's graph; it never enters wolf-core's tree.
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_static_library", "rust_test")
load("@build_bazel_rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")

exports_files(["Cargo.toml"])

# The swift-bridge-generated Swift glue (committed). Compiled INTO the Swift
# front-end's `wolf_key_map` module so `FfiKeyEvent` and the `WolfCoreHandle` /
# `FfiFrame` wrappers are available to Swift. Foundation-only (no AppKit).
filegroup(
    name = "generated_swift",
    srcs = [
        "generated/SwiftBridgeCore.swift",
        "generated/wolf-ffi.swift",
    ],
    visibility = ["//visibility:public"],
)

# The hand-written Rust glue + the swift-bridge `mod ffi`. The crate-types come
# from Cargo.toml (staticlib + rlib); rust_library produces the rlib used by the
# Rust integration test, rust_static_library produces libwolf_ffi.a for the app.
_WOLF_FFI_DEPS = [
    "//crates/wolf-core:wolf_core",
    "@crates//:swift-bridge",
    "@crates//:tracing",
]

rust_library(
    name = "wolf_ffi",
    srcs = ["src/lib.rs"],
    crate_name = "wolf_ffi",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = _WOLF_FFI_DEPS,
)

rust_static_library(
    name = "wolf_ffi_staticlib",
    srcs = ["src/lib.rs"],
    crate_name = "wolf_ffi",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = _WOLF_FFI_DEPS,
)

# C interface for Swift: the committed generated headers + the hand-written wake
# header, with the staticlib linked in. The interop hint names the Clang module
# `WolfFFI` (matching the committed module.modulemap and the `import WolfFFI` line
# gen_bindings prepends), using the committed module map so the module layout is
# identical under Bazel and under Xcode/SwiftPM.
swift_interop_hint(
    name = "wolf_ffi_cc_hint",
    module_map = "generated/module.modulemap",
    module_name = "WolfFFI",
)

cc_library(
    name = "wolf_ffi_cc",
    hdrs = glob(["generated/*.h"]) + ["generated/module.modulemap"],
    aspect_hints = [":wolf_ffi_cc_hint"],
    includes = ["generated"],
    visibility = ["//visibility:public"],
    deps = [":wolf_ffi_staticlib"],
)

rust_binary(
    name = "gen_bindings",
    srcs = ["src/bin/gen_bindings.rs"],
    edition = "2021",
    visibility = ["//visibility:private"],
    deps = ["@crates//:swift-bridge-build"],
)

rust_test(
    name = "bridge_smoke",
    srcs = [
        "tests/bridge_smoke.rs",
        "tests/common/mod.rs",
    ],
    crate_root = "tests/bridge_smoke.rs",
    edition = "2021",
    # The test names `wolf_ffi::{...}` and drives a real nvim when WOLF_NVIM_BIN is
    # set, loudly skipping otherwise. WOLF_NVIM_BIN is read from the environment at
    # runtime (not provisioned on the macOS Bazel host).
    deps = [":wolf_ffi"] + all_crate_deps(normal_dev = True),
)

# Headless, deterministic packing test: builds a `wolf_core::Snapshot` by hand and
# asserts `FfiFrame::from_snapshot`'s color packing, flag bits, cursor reverse-video,
# shape/visibility, and the flat `cells()` grid. Needs no nvim — MUST pass regardless
# of WOLF_NVIM_BIN. `wolf-core` is on the dep line so the test can name its builders.
rust_test(
    name = "frame_pack",
    srcs = ["tests/frame_pack.rs"],
    crate_root = "tests/frame_pack.rs",
    edition = "2021",
    deps = [
        ":wolf_ffi",
        "//crates/wolf-core:wolf_core",
    ],
)
