# Bazel build for the macOS (AppKit) front-end, `wolf-macos`.
#
# Targets:
#   - wolf_key_map      : the PURE key-translation seam (Foundation + the generated
#                         FFI glue only, NO AppKit), unit-tested headlessly.
#   - wolf_macos_lib    : the AppKit application sources (AppKit/CoreText/
#                         CoreGraphics/Foundation), depending on wolf_key_map and
#                         the C FFI module.
#   - Wolf              : the macos_application bundle (minimum_os_version 26.0).
#   - WolfKeyMapTests   : the swift_test over the pure seam.
#   - xcodeproj         : an UNCOMMITTED Xcode project for debugging/LLDB only.
load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcodeproj", "top_level_target")

# The pure key-translation seam. Compiles `KeyMap.swift` together with the
# swift-bridge-generated Swift glue (which provides `FfiKeyEvent` and the
# `WolfCoreHandle` / `FfiFrame` wrappers) into one Foundation-only module — NO
# AppKit — so it is unit-testable without a window. Depends on the C FFI module
# (`WolfFFI`) for the underlying symbols.
swift_library(
    name = "wolf_key_map",
    srcs = [
        "Sources/WolfKeyMap/CellMetricsMath.swift",
        "Sources/WolfKeyMap/GlyphStyle.swift",
        "Sources/WolfKeyMap/KeyMap.swift",
        "Sources/WolfKeyMap/PaneGeometry.swift",
        "Sources/WolfKeyMap/PaneTree.swift",
        "Sources/WolfKeyMap/PickerSeam.swift",
        "Sources/WolfKeyMap/ScrollAccumulator.swift",
        "Sources/WolfKeyMap/StateSeam.swift",
    ] + ["//crates/wolf-ffi:generated_swift"],
    module_name = "WolfKeyMap",
    visibility = ["//visibility:public"],
    deps = ["//crates/wolf-ffi:wolf_ffi_cc"],
)

# The AppKit application sources. Gets `FfiKeyEvent` / `WolfCoreHandle` / `FfiFrame`
# via `import WolfKeyMap`, and the C wake symbol via `import WolfFFI`.
swift_library(
    name = "wolf_macos_lib",
    srcs = glob(["Sources/WolfMacOS/*.swift"]),
    module_name = "WolfMacOS",
    visibility = ["//visibility:public"],
    deps = [
        ":wolf_key_map",
        "//crates/wolf-ffi:wolf_ffi_cc",
    ],
)

macos_application(
    name = "Wolf",
    bundle_id = "org.wolf.WolfMacOS",
    bundle_name = "Wolf",
    infoplists = ["Info.plist"],
    minimum_os_version = "26.0",
    # The pinned Neovim 0.12.3 tree (structure-preserving `nvim/` TreeArtifact)
    # lands at `Contents/Resources/nvim/`; the vendored orlando plugin tree
    # (structure-preserving `orlando/` TreeArtifact) lands at
    # `Contents/Resources/orlando/`; the vendored lighthouse colorscheme tree
    # (structure-preserving `lighthouse/` TreeArtifact) lands at
    # `Contents/Resources/lighthouse/` (both loaded/activated by the captive
    # init.lua, not Swift); the vendored nvim-treesitter + textobjects plugin
    # trees land at `Contents/Resources/nvim-treesitter/` and
    # `Contents/Resources/nvim-treesitter-textobjects/`, and the curated
    # host-compiled treesitter parsers (structure-preserving `parsers/`
    # TreeArtifact) land at `Contents/Resources/parsers/parser/<lang>.so` — these
    # three are VENDORED/SHIPPED and treesitter highlighting + fenced-code injection
    # are ENABLED on macOS by the captive init.lua; the vendored JetBrains Mono
    # fonts (structure-preserving `fonts/` TreeArtifact: four TTF faces + OFL.txt)
    # AND the vendored iA Writer Mono S fonts (structure-preserving `fonts/`
    # TreeArtifact: four TTF faces + LICENSE.md) BOTH merge into the SAME
    # `Contents/Resources/fonts/` dir (disjoint file sets), where
    # `FontRegistration.swift` glob-registers every `*.ttf` with CoreText so both
    # "JetBrains Mono" and the DEFAULT "iA Writer Mono S" resolve as grid fonts; the
    # captive `init.lua` lands flat at `Contents/Resources/init.lua` (resolved by
    # `Bundle.main.path`).
    resources = [
        "//bazel/ia-writer-mono:ia_writer_mono_tree",
        "//bazel/jetbrains-mono:jetbrains_mono_tree",
        "//bazel/lighthouse:lighthouse_tree",
        "//bazel/nvim:nvim_tree",
        "//bazel/nvim-treesitter:nvim_treesitter_tree",
        "//bazel/nvim-treesitter-textobjects:nvim_treesitter_textobjects_tree",
        "//bazel/orlando:orlando_tree",
        "//bazel/treesitter-parsers:parsers_tree",
        "//runtime/nvim:init.lua",
    ],
    visibility = ["//visibility:public"],
    deps = [":wolf_macos_lib"],
)

# Inspects the built `.app`: asserts the pinned nvim tree + captive init.lua
# landed at the expected resource paths with the exec bit preserved, plus the
# vendored orlando plugin resource files (checks e/f:
# Contents/Resources/orlando/plugin/orlando.lua and .../lua/orlando/init.lua),
# the vendored lighthouse colorscheme file (check g:
# Contents/Resources/lighthouse/colors/lighthouse.lua), the vendored
# nvim-treesitter markdown query (check h) + textobjects Lua dir (check i), and
# the curated host-compiled treesitter parsers (check j:
# Contents/Resources/parsers/parser/<lang>.so, HARD for go/rust/typescript/tsx/
# json, SOFT for swift/kotlin/java). These three are VENDORED/SHIPPED and
# treesitter highlighting + fenced-code injection are ENABLED on macOS by init.lua.
sh_test(
    name = "bundle_layout_test",
    srcs = ["bundle_layout_test.sh"],
    data = [":Wolf"],
)

swift_test(
    name = "WolfKeyMapTests",
    srcs = [
        "Tests/WolfKeyMapTests/CellMetricsMathTests.swift",
        "Tests/WolfKeyMapTests/GlyphStyleTests.swift",
        "Tests/WolfKeyMapTests/KeyMapTests.swift",
        "Tests/WolfKeyMapTests/PaneGeometryTests.swift",
        "Tests/WolfKeyMapTests/PaneTreeTests.swift",
        "Tests/WolfKeyMapTests/PickerSeamTests.swift",
        "Tests/WolfKeyMapTests/ScrollAccumulatorTests.swift",
        "Tests/WolfKeyMapTests/StateSeamTests.swift",
    ],
    deps = [":wolf_key_map"],
)

xcodeproj(
    name = "xcodeproj",
    project_name = "Wolf",
    top_level_targets = [
        top_level_target(":Wolf", target_environments = ["device"]),
    ],
)
