# Bazel build for the macOS (AppKit) front-end; targets are in crates/wolf-macos/README.md.
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcodeproj", "top_level_target")
load("//crates/wolf-macos:release.bzl", "opt_bundle")
load("//tools/lint:defs.bzl", "comment_srcs")

# Enumerated here because Bazel forbids cross-package globbing, for //tools/lint's swift-format.
# Excludes the generated swift-bridge bindings in //crates/wolf-ffi:generated, not ours to format.
filegroup(
    name = "swift_format_srcs",
    srcs = glob([
        "Sources/WolfKeyMap/*.swift",
        "Sources/WolfMacOS/*.swift",
        "Tests/WolfKeyMapTests/*.swift",
    ]),
    visibility = ["//tools/lint:__pkg__"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs(exclude = ["*.xcodeproj/**"])

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)

# The pure seam: these sources plus the generated swift-bridge glue, as one Foundation-only
# module with no AppKit, so it is unit-testable without a window.
swift_library(
    name = "wolf_key_map",
    srcs = [
        "Sources/WolfKeyMap/AppearanceSeam.swift",
        "Sources/WolfKeyMap/CellMetricsMath.swift",
        "Sources/WolfKeyMap/CmdlineSeam.swift",
        "Sources/WolfKeyMap/CommandSeam.swift",
        "Sources/WolfKeyMap/CwdTitleSeam.swift",
        "Sources/WolfKeyMap/DividerDragSeam.swift",
        "Sources/WolfKeyMap/DividerHitTest.swift",
        "Sources/WolfKeyMap/DrawerFocusSeam.swift",
        "Sources/WolfKeyMap/DrawerLayout.swift",
        "Sources/WolfKeyMap/EditorInset.swift",
        "Sources/WolfKeyMap/FontSizeSeam.swift",
        "Sources/WolfKeyMap/FrameStats.swift",
        "Sources/WolfKeyMap/GlyphStyle.swift",
        "Sources/WolfKeyMap/HistorySeam.swift",
        "Sources/WolfKeyMap/KeyComposition.swift",
        "Sources/WolfKeyMap/KeyMap.swift",
        "Sources/WolfKeyMap/OtherPaneSeam.swift",
        "Sources/WolfKeyMap/PaneGeometry.swift",
        "Sources/WolfKeyMap/PaneLayoutCodec.swift",
        "Sources/WolfKeyMap/PaneModeSeam.swift",
        "Sources/WolfKeyMap/PaneOcclusion.swift",
        "Sources/WolfKeyMap/PaneTree.swift",
        "Sources/WolfKeyMap/PaletteSeam.swift",
        "Sources/WolfKeyMap/PickerPanelSeam.swift",
        "Sources/WolfKeyMap/PickerRefreshCoalescer.swift",
        "Sources/WolfKeyMap/PickerSeam.swift",
        "Sources/WolfKeyMap/PreviewCopySeam.swift",
        "Sources/WolfKeyMap/PreviewLinkSeam.swift",
        "Sources/WolfKeyMap/PreviewScrollSeam.swift",
        "Sources/WolfKeyMap/PreviewSeam.swift",
        "Sources/WolfKeyMap/RestoreSeam.swift",
        "Sources/WolfKeyMap/ScrollAccumulator.swift",
        "Sources/WolfKeyMap/SearchBudgetSeam.swift",
        "Sources/WolfKeyMap/SearchHighlightSeam.swift",
        "Sources/WolfKeyMap/SearchToggleSeam.swift",
        "Sources/WolfKeyMap/ShortcutSeam.swift",
        "Sources/WolfKeyMap/SidebarMenuSeam.swift",
        "Sources/WolfKeyMap/SidebarRowStyle.swift",
        "Sources/WolfKeyMap/StateSeam.swift",
        "Sources/WolfKeyMap/StatusbarLayout.swift",
        "Sources/WolfKeyMap/StatusbarTextSpan.swift",
        "Sources/WolfKeyMap/TreeChildrenMemo.swift",
        "Sources/WolfKeyMap/TreeRefreshGate.swift",
    ] + ["//crates/wolf-ffi:generated_swift"],
    module_name = "WolfKeyMap",
    visibility = ["//visibility:public"],
    deps = ["//crates/wolf-ffi:wolf_ffi_cc"],
)

# The AppKit application sources. Gets `FfiKeyEvent` / `WolfCoreHandle` / `FfiFrame`
# via `import WolfKeyMap`, and the C wake symbol via `import WolfFFI`.
swift_library(
    name = "wolf_macos_lib",
    srcs = glob(["Sources/WolfMacOS/*.swift"]),
    module_name = "WolfMacOS",
    visibility = ["//visibility:public"],
    deps = [
        ":wolf_key_map",
        "//crates/wolf-ffi:wolf_ffi_cc",
    ],
)

# `Wolf.icon/` is assembled in the output tree, all three files in one dir: actool needs every
# `app_icons` file under exactly one `*.icon` dir, and source and bazel-out paths count as two.
copy_file(
    name = "wolf_icon_json",
    src = "Wolf.icon.json",
    out = "Wolf.icon/icon.json",
    # skylib defaults allow_symlink to True for non-executables, but actool
    # rejects a symlinked icon.json ("must be a regular file") — force copies.
    allow_symlink = False,
)

copy_file(
    name = "wolf_icon_light",
    src = "//resources/icons:Wolf application icon macOS light/icon-silhouette_512x512@2x.png",
    out = "Wolf.icon/Assets/wolf-light.png",
    allow_symlink = False,
)

copy_file(
    name = "wolf_icon_dark",
    src = "//resources/icons:Wolf application icon macos dark/icon-silhouette_512x512@2x.png",
    out = "Wolf.icon/Assets/wolf-dark.png",
    allow_symlink = False,
)

macos_application(
    name = "Wolf",
    # actool compiles `Wolf.icon/` into Assets.car; at minimum_os_version 26.0 an `.icon` bundle
    # is the only route rules_apple accepts, and a legacy .appiconset fails the build.
    app_icons = [
        ":wolf_icon_json",
        ":wolf_icon_light",
        ":wolf_icon_dark",
    ],
    bundle_id = "org.wolf.WolfMacOS",
    bundle_name = "Wolf",
    infoplists = ["Info.plist"],
    minimum_os_version = "26.0",
    # Each tree lands under Contents/Resources/; both font trees merge into one fonts/ dir.
    # See crates/wolf-macos/README.md#bundle-contents
    resources = [
        "//bazel/ia-writer-mono:ia_writer_mono_tree",
        "//bazel/jetbrains-mono:jetbrains_mono_tree",
        "//bazel/lighthouse:lighthouse_tree",
        "//bazel/nvim:nvim_tree",
        "//bazel/nvim-treesitter:nvim_treesitter_tree",
        "//bazel/nvim-treesitter-textobjects:nvim_treesitter_textobjects_tree",
        "//bazel/orlando:orlando_tree",
        "//bazel/rg:rg_tree",
        "//bazel/treesitter-parsers:parsers_tree",
        "//runtime/nvim:init.lua",
    ],
    visibility = ["//visibility:public"],
    deps = [":wolf_macos_lib"],
)

# `:Wolf` rebuilt at `-c opt` by transition; `manual` stops `//...` building the graph twice.
# See notes/wolf-macos-decisions.md#why-wolfrelease-is-a-custom-rule
opt_bundle(
    name = "WolfRelease",
    bundle = ":Wolf",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# The archive must reach :InstallWolf through this filegroup, not `$(rootpath :WolfRelease)`.
# See notes/wolf-macos-decisions.md#why-installwolf-takes-the-archive-through-a-filegroup
filegroup(
    name = "wolf_release_archive",
    srcs = [":WolfRelease"],
    tags = ["manual"],
)

sh_binary(
    name = "InstallWolf",
    srcs = ["install_wolf.sh"],
    args = ["$(rootpath :wolf_release_archive)"],
    data = [":wolf_release_archive"],
    tags = ["manual"],
)

# Asserts the built `.app`'s bundled resource layout, exec bits included.
sh_test(
    name = "bundle_layout_test",
    srcs = ["bundle_layout_test.sh"],
    data = [":Wolf"],
)

swift_test(
    name = "WolfKeyMapTests",
    srcs = [
        "Tests/WolfKeyMapTests/AppearanceSeamTests.swift",
        "Tests/WolfKeyMapTests/CellMetricsMathTests.swift",
        "Tests/WolfKeyMapTests/CmdlineSeamTests.swift",
        "Tests/WolfKeyMapTests/CommandSeamTests.swift",
        "Tests/WolfKeyMapTests/CwdTitleSeamTests.swift",
        "Tests/WolfKeyMapTests/DividerDragSeamTests.swift",
        "Tests/WolfKeyMapTests/DividerHitTestTests.swift",
        "Tests/WolfKeyMapTests/DrawerFocusSeamTests.swift",
        "Tests/WolfKeyMapTests/DrawerLayoutTests.swift",
        "Tests/WolfKeyMapTests/EditorInsetTests.swift",
        "Tests/WolfKeyMapTests/FontSizeSeamTests.swift",
        "Tests/WolfKeyMapTests/FrameStatsTests.swift",
        "Tests/WolfKeyMapTests/GlyphStyleTests.swift",
        "Tests/WolfKeyMapTests/HistorySeamTests.swift",
        "Tests/WolfKeyMapTests/KeyCompositionTests.swift",
        "Tests/WolfKeyMapTests/KeyMapTests.swift",
        "Tests/WolfKeyMapTests/OtherPaneSeamTests.swift",
        "Tests/WolfKeyMapTests/PaneGeometryTests.swift",
        "Tests/WolfKeyMapTests/PaletteSeamTests.swift",
        "Tests/WolfKeyMapTests/PaneLayoutCodecTests.swift",
        "Tests/WolfKeyMapTests/PaneModeSeamTests.swift",
        "Tests/WolfKeyMapTests/PaneOcclusionTests.swift",
        "Tests/WolfKeyMapTests/PaneTreeTests.swift",
        "Tests/WolfKeyMapTests/PaneTreeWeightsTests.swift",
        "Tests/WolfKeyMapTests/PickerPanelSeamTests.swift",
        "Tests/WolfKeyMapTests/PickerRefreshCoalescerTests.swift",
        "Tests/WolfKeyMapTests/PickerSeamTests.swift",
        "Tests/WolfKeyMapTests/PreviewCopySeamTests.swift",
        "Tests/WolfKeyMapTests/PreviewLinkSeamTests.swift",
        "Tests/WolfKeyMapTests/PreviewScrollSeamTests.swift",
        "Tests/WolfKeyMapTests/PreviewSeamTests.swift",
        "Tests/WolfKeyMapTests/RestoreSeamTests.swift",
        "Tests/WolfKeyMapTests/ScrollAccumulatorTests.swift",
        "Tests/WolfKeyMapTests/SearchBudgetSeamTests.swift",
        "Tests/WolfKeyMapTests/SearchHighlightSeamTests.swift",
        "Tests/WolfKeyMapTests/SearchToggleSeamTests.swift",
        "Tests/WolfKeyMapTests/ShortcutSeamTests.swift",
        "Tests/WolfKeyMapTests/SidebarMenuSeamTests.swift",
        "Tests/WolfKeyMapTests/SidebarRowStyleTests.swift",
        "Tests/WolfKeyMapTests/StateSeamTests.swift",
        "Tests/WolfKeyMapTests/StatusbarLayoutTests.swift",
        "Tests/WolfKeyMapTests/StatusbarTextSpanTests.swift",
        "Tests/WolfKeyMapTests/TreeChildrenMemoTests.swift",
        "Tests/WolfKeyMapTests/TreeRefreshGateTests.swift",
    ],
    deps = [":wolf_key_map"],
)

xcodeproj(
    name = "xcodeproj",
    project_name = "Wolf",
    top_level_targets = [
        top_level_target(":Wolf", target_environments = ["device"]),
    ],
)
