# The JetBrains Mono `fonts/` TreeArtifact and its smoke test; arch-independent data, so no
# `select()`. See bazel/jetbrains-mono/README.md for the pin and how to bump it.
load("//tools/lint:defs.bzl", "comment_srcs")

# The assembled JetBrains Mono tree (a `fonts/` TreeArtifact:
# JetBrainsMono-{Regular,Italic,Bold,BoldItalic}.ttf + OFL.txt).
alias(
    name = "jetbrains_mono_tree",
    actual = "@jetbrains_mono//:jetbrains_mono_tree",
    visibility = ["//visibility:public"],
)

# Asserts the four TTF faces + OFL.txt landed at the expected paths inside the tree.
sh_test(
    name = "jetbrains_mono_tree_test",
    srcs = ["jetbrains_mono_tree_test.sh"],
    data = [":jetbrains_mono_tree"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
