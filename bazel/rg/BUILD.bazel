# The arch-selected ripgrep 15.2.0 `rg/` TreeArtifact and its smoke test.
# See bazel/rg/README.md for the pins and how to bump them.
load("//tools/lint:defs.bzl", "comment_srcs")

# The host-arch ripgrep tree (a `rg/` TreeArtifact containing `rg/rg`). Selected on
# @platforms//cpu.
alias(
    name = "rg_tree",
    actual = select({
        "@platforms//cpu:arm64": "@rg_macos_arm64//:rg_tree",
        "@platforms//cpu:x86_64": "@rg_macos_x86_64//:rg_tree",
    }),
    visibility = ["//visibility:public"],
)

# Exercises the pinned binary: exists + executable, reports `ripgrep 15.2.0`.
sh_test(
    name = "rg_version_test",
    srcs = ["rg_version_test.sh"],
    data = [":rg_tree"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
