# The lighthouse colorscheme TreeArtifact and its smoke test; pure Lua, so no `select()`.
# See bazel/lighthouse/README.md for the pin and how to bump it.
load("//tools/lint:defs.bzl", "comment_srcs")

# The assembled lighthouse tree (a `lighthouse/` TreeArtifact: colors/lighthouse.lua,
# LICENSE*).
alias(
    name = "lighthouse_tree",
    actual = "@lighthouse//:lighthouse_tree",
    visibility = ["//visibility:public"],
)

# Asserts the vendored colorscheme file landed at the expected path inside the tree.
sh_test(
    name = "lighthouse_tree_test",
    srcs = ["lighthouse_tree_test.sh"],
    data = [":lighthouse_tree"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
