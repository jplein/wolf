# The orlando plugin TreeArtifact and its smoke test; pure Lua, so no `select()`.
# See bazel/orlando/README.md for the pin and how to bump it.
load("//tools/lint:defs.bzl", "comment_srcs")

# The assembled orlando tree (an `orlando/` TreeArtifact: plugin/orlando.lua,
# lua/orlando/**, doc/**, LICENSE*).
alias(
    name = "orlando_tree",
    actual = "@orlando//:orlando_tree",
    visibility = ["//visibility:public"],
)

# Asserts the vendored plugin files landed at the expected paths inside the tree.
sh_test(
    name = "orlando_tree_test",
    srcs = ["orlando_tree_test.sh"],
    data = [":orlando_tree"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
