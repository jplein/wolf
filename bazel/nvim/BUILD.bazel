# The arch-selected Neovim 0.12.3 `nvim/` TreeArtifact and its smoke test.
# See bazel/nvim/README.md for the pins and how to bump them.
load("//tools/lint:defs.bzl", "comment_srcs")

# The host-arch Neovim tree (a `nvim/` TreeArtifact: bin/nvim, lib/nvim/parser,
# share/nvim/runtime, ...). Selected on @platforms//cpu.
alias(
    name = "nvim_tree",
    actual = select({
        "@platforms//cpu:arm64": "@nvim_macos_arm64//:nvim_tree",
        "@platforms//cpu:x86_64": "@nvim_macos_x86_64//:nvim_tree",
    }),
    visibility = ["//visibility:public"],
)

# Exercises the pinned binary: exists + executable, reports `NVIM v0.12.3`, and
# self-locates its runtime (VIMRUNTIME) INSIDE the bundled tree.
sh_test(
    name = "nvim_version_test",
    srcs = ["nvim_version_test.sh"],
    data = [":nvim_tree"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
