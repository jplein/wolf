# The iA Writer Mono S `fonts/` TreeArtifact and its smoke test; arch-independent data, so no
# `select()`. See bazel/ia-writer-mono/README.md for the pin and how to bump it.
load("//tools/lint:defs.bzl", "comment_srcs")

# The assembled iA Writer Mono S tree (a `fonts/` TreeArtifact:
# iAWriterMonoS-{Regular,Italic,Bold,BoldItalic}.ttf + LICENSE.md).
alias(
    name = "ia_writer_mono_tree",
    actual = "@ia_writer_mono//:ia_writer_mono_tree",
    visibility = ["//visibility:public"],
)

# Asserts the four TTF faces + LICENSE.md landed at the expected paths inside the
# tree.
sh_test(
    name = "ia_writer_mono_tree_test",
    srcs = ["ia_writer_mono_tree_test.sh"],
    data = [":ia_writer_mono_tree"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
