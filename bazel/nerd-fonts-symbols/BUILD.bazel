# The Symbols Nerd Font Mono `fonts/` TreeArtifact and its smoke test; arch-independent data, so
# no `select()`. See this package's README.md for the pin and how to bump it.
load("//tools/lint:defs.bzl", "comment_srcs")

# The assembled tree (a `fonts/` TreeArtifact: SymbolsNerdFontMono-Regular.ttf,
# nerd-fonts-symbols-LICENSE and nerd-fonts-symbols-README.md).
alias(
    name = "nerd_fonts_symbols_tree",
    actual = "@nerd_fonts_symbols//:nerd_fonts_symbols_tree",
    visibility = ["//visibility:public"],
)

# Asserts the Mono face and its two notices landed in the tree, and the excluded files did not.
sh_test(
    name = "nerd_fonts_symbols_tree_test",
    srcs = ["nerd_fonts_symbols_tree_test.sh"],
    data = [":nerd_fonts_symbols_tree"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
