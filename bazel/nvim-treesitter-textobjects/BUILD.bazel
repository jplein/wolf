# The nvim-treesitter-textobjects TreeArtifact and its smoke test; vendored only, not enabled.
# Pure Lua, so no `select()`. See bazel/nvim-treesitter-textobjects/README.md for the pin.
load("//tools/lint:defs.bzl", "comment_srcs")

# The assembled tree: `lua/nvim-treesitter-textobjects/**`, `queries/**` and LICENSE, in the
# `main` branch's layout with no top-level `plugin/` loader.
alias(
    name = "nvim_treesitter_textobjects_tree",
    actual = "@nvim_treesitter_textobjects//:nvim_treesitter_textobjects_tree",
    visibility = ["//visibility:public"],
)

# Asserts the vendored plugin files landed at the expected paths inside the tree.
sh_test(
    name = "nvim_treesitter_textobjects_tree_test",
    srcs = ["nvim_treesitter_textobjects_tree_test.sh"],
    data = [":nvim_treesitter_textobjects_tree"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
