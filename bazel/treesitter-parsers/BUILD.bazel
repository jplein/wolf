# Host-compiled treesitter parsers merged into one `parsers/` TreeArtifact, plus a smoke test.
# No `select()`: the cc toolchain resolves the host arch. See bazel/treesitter-parsers/README.md.

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("//tools/lint:defs.bzl", "comment_srcs")

# `replace_prefixes` maps each `parser/<lang>.so` under an inner `parsers/`, because rules_apple
# strips a TreeArtifact's own top-level name when bundling it.
copy_to_directory(
    name = "parsers_tree",
    srcs = [
        "@ts_bash//:bash_parser",
        "@ts_c//:c_parser",
        "@ts_cpp//:cpp_parser",
        "@ts_css//:css_parser",
        "@ts_go//:go_parser",
        "@ts_html//:html_parser",
        "@ts_java//:java_parser",
        "@ts_javascript//:javascript_parser",
        "@ts_json//:json_parser",
        "@ts_kotlin//:kotlin_parser",
        "@ts_rust//:rust_parser",
        "@ts_swift//:swift_parser",
        "@ts_toml//:toml_parser",
        "@ts_typescript//:tsx_parser",
        "@ts_typescript//:typescript_parser",
        "@ts_yaml//:yaml_parser",
    ],
    out = "parsers_tree",
    # Match the bzlmod CANONICAL external-repo names (e.g. `+treesitter_parsers+
    # ts_go`), not the apparent `ts_go`, so a leading `*` is required.
    include_external_repositories = ["*ts_*"],
    replace_prefixes = {"parser": "parsers/parser"},
    visibility = ["//visibility:public"],
)

# Asserts the curated compiled parser `.so`s landed non-empty at the expected paths
# inside the tree (HARD: go/rust/typescript/tsx/json; SOFT: swift/kotlin/java).
sh_test(
    name = "parsers_tree_test",
    srcs = ["parsers_tree_test.sh"],
    data = [":parsers_tree"],
)

# Runs the pinned nvim to compile each vendored nvim-treesitter highlights/injections query
# against the parser built here, so a grammar re-pin cannot drift from the queries unnoticed.
sh_test(
    name = "queries_compile_test",
    srcs = ["queries_compile_test.sh"],
    args = ["$(rootpath :queries_compile_probe.lua)"],
    data = [
        ":parsers_tree",
        ":queries_compile_probe.lua",
        "//bazel/nvim:nvim_tree",
        "//bazel/nvim-treesitter:nvim_treesitter_tree",
    ],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
