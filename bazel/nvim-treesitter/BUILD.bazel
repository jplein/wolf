# The nvim-treesitter TreeArtifact and its smoke test; the captive init.lua enables its markdown
# queries on macOS. Pure Lua, so no `select()`. See bazel/nvim-treesitter/README.md.
load("//tools/lint:defs.bzl", "comment_srcs")

# The assembled nvim-treesitter tree (a `nvim-treesitter/` TreeArtifact:
# queries/**, lua/nvim-treesitter/**, plugin/**, LICENSE).
alias(
    name = "nvim_treesitter_tree",
    actual = "@nvim_treesitter//:nvim_treesitter_tree",
    visibility = ["//visibility:public"],
)

# Asserts the vendored plugin files landed at the expected paths inside the tree.
sh_test(
    name = "nvim_treesitter_tree_test",
    srcs = ["nvim_treesitter_tree_test.sh"],
    data = [":nvim_treesitter_tree"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
