# Lint and format checks, which gate `bazel test //...`, and their `manual` fix targets.
# What each target runs and why: tools/lint/README.md
load("@rules_rust//rust:defs.bzl", "rust_clippy", "rustfmt_test")
load(":clippy_fix.bzl", "clippy_fix", "fix_all")
load(":defs.bzl", "comment_srcs")

package(default_visibility = ["//visibility:public"])

# ---- clippy ----

rust_clippy(
    name = "clippy_core",
    testonly = True,
    deps = ["//crates/wolf-core:wolf_core"],
)

rust_clippy(
    name = "clippy_ffi",
    testonly = True,
    deps = ["//crates/wolf-ffi:wolf_ffi"],
)

rust_clippy(
    name = "clippy_doc_lint",
    testonly = True,
    deps = ["//tools/doc-lint:doc_lint_lib"],
)

# Staging the rust_clippy targets as data builds them, which runs clippy, so a lint fails this.
sh_test(
    name = "clippy",
    srcs = ["clippy_gate.sh"],
    data = [
        ":clippy_core",
        ":clippy_doc_lint",
        ":clippy_ffi",
    ],
)

clippy_fix(
    name = "clippy.fix",
    tags = ["manual"],
)

# ---- rustfmt ----

rustfmt_test(
    name = "rustfmt_core",
    targets = ["//crates/wolf-core:wolf_core"],
)

rustfmt_test(
    name = "rustfmt_ffi",
    targets = ["//crates/wolf-ffi:wolf_ffi"],
)

rustfmt_test(
    name = "rustfmt_doc_lint",
    targets = [
        "//tools/doc-lint:doc_lint",
        "//tools/doc-lint:doc_lint_lib",
    ],
)

test_suite(
    name = "rustfmt",
    tests = [
        ":rustfmt_core",
        ":rustfmt_doc_lint",
        ":rustfmt_ffi",
    ],
)

alias(
    name = "rustfmt.fix",
    actual = "@rules_rust//:rustfmt",
    tags = ["manual"],
)

# ---- swift-format ----

# `no-sandbox`: swift-format is the host Xcode binary, not a hermetic input.
sh_test(
    name = "swift_format",
    srcs = ["swift_format_check.sh"],
    args = ["$(rootpaths //crates/wolf-macos:swift_format_srcs)"],
    data = ["//crates/wolf-macos:swift_format_srcs"],
    tags = ["no-sandbox"],
)

sh_binary(
    name = "swift_format.fix",
    srcs = ["swift_format_fix.sh"],
    tags = ["manual"],
)

# ---- markdown ----

comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        exclude = ["testdata/**"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)

# Every package's docs. doc-lint's bazel-coverage rule fails when a package is missing here.
filegroup(
    name = "all_markdown_srcs",
    srcs = [
        "//:markdown_srcs",
        "//bazel/ia-writer-mono:markdown_srcs",
        "//bazel/jetbrains-mono:markdown_srcs",
        "//bazel/lighthouse:markdown_srcs",
        "//bazel/nvim:markdown_srcs",
        "//bazel/nvim-treesitter:markdown_srcs",
        "//bazel/nvim-treesitter-textobjects:markdown_srcs",
        "//bazel/orlando:markdown_srcs",
        "//bazel/rg:markdown_srcs",
        "//bazel/treesitter-parsers:markdown_srcs",
        "//crates/wolf-core:markdown_srcs",
        "//crates/wolf-ffi:markdown_srcs",
        "//crates/wolf-macos:markdown_srcs",
        "//resources/icons:markdown_srcs",
        "//runtime/nvim:markdown_srcs",
        "//tools/doc-lint:markdown_srcs",
        "//tools/lint:markdown_srcs",
    ],
)

sh_test(
    name = "markdown",
    srcs = ["markdown_check.sh"],
    args = ["$(rootpaths :all_markdown_srcs)"],
    data = [":all_markdown_srcs"],
)

sh_test(
    name = "markdown_check_test",
    srcs = ["markdown_check_test.sh"],
    data = ["markdown_check.sh"] + glob(["testdata/**"]),
)

# ---- comments ----

# Every package's comment-checked sources; bazel-coverage guards this list too.
filegroup(
    name = "all_comment_srcs",
    srcs = [
        "//:comment_srcs",
        "//bazel/ia-writer-mono:comment_srcs",
        "//bazel/jetbrains-mono:comment_srcs",
        "//bazel/lighthouse:comment_srcs",
        "//bazel/nvim:comment_srcs",
        "//bazel/nvim-treesitter:comment_srcs",
        "//bazel/nvim-treesitter-textobjects:comment_srcs",
        "//bazel/orlando:comment_srcs",
        "//bazel/rg:comment_srcs",
        "//bazel/treesitter-parsers:comment_srcs",
        "//crates/wolf-core:comment_srcs",
        "//crates/wolf-ffi:comment_srcs",
        "//crates/wolf-macos:comment_srcs",
        "//resources/icons:comment_srcs",
        "//runtime/nvim:comment_srcs",
        "//tools/doc-lint:comment_srcs",
        "//tools/lint:comment_srcs",
    ],
)

# The Markdown is data so that doc-lint can resolve the doc paths written in comments.
sh_test(
    name = "comments",
    srcs = ["doc_lint_check.sh"],
    args = [
        "$(rootpath //tools/doc-lint:doc_lint)",
        "$(rootpaths :all_comment_srcs)",
    ],
    data = [
        ":all_comment_srcs",
        ":all_markdown_srcs",
        "//tools/doc-lint:doc_lint",
    ],
)

# ---- aggregates ----

test_suite(
    name = "check",
    tests = [
        ":clippy",
        ":comments",
        ":markdown",
        ":markdown_check_test",
        ":rustfmt_core",
        ":rustfmt_doc_lint",
        ":rustfmt_ffi",
        ":swift_format",
    ],
)

fix_all(
    name = "fix",
    tags = ["manual"],
)
