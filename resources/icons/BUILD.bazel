load("//tools/lint:defs.bzl", "comment_srcs")

# The two 1024x1024 masters for //crates/wolf-macos:Wolf; actool derives every icon size
# per appearance from them.
exports_files(
    [
        "Wolf application icon macOS light/icon-silhouette_512x512@2x.png",
        "Wolf application icon macos dark/icon-silhouette_512x512@2x.png",
    ],
    visibility = ["//crates/wolf-macos:__pkg__"],
)

# This package's sources and docs for //tools/lint, which cannot glob across packages.
comment_srcs()

filegroup(
    name = "markdown_srcs",
    srcs = glob(
        ["**/*.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)
