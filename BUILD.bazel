load("//tools/lint:defs.bzl", "COMMENT_LINT_PATTERNS", "comment_srcs")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# Root files and package-less dirs; globs stop at packages, and `*` skips dotfiles (hence `.*.md`).
# CLAUDE.md quotes the changelog words it bans, so it is out of the Markdown check's scope.
filegroup(
    name = "markdown_srcs",
    srcs = glob(
        [
            "*.md",
            "notes/**/*.md",
            "notes/**/.*.md",
            "specs/**/*.md",
            "crates/wolf-gnome/**/*.md",
            "tools/*.md",
            "tools/wolf-pointer-inject/**/*.md",
            "resources/*.md",
        ],
        exclude = ["CLAUDE.md"],
        allow_empty = True,
    ),
    visibility = ["//tools/lint:__pkg__"],
)

# Top-level names only: a root `**/` pattern would descend into target/, result/ and other
# directories that are no package's sources.
comment_srcs(include = [
    "BUILD.bazel",
    "MODULE.bazel",
    "*.toml",
    "*.nix",
    ".bazelrc",
    ".bazelignore",
    ".gitignore",
    ".prettierignore",
    ".envrc",
] + [
    "crates/wolf-gnome/" + p
    for p in COMMENT_LINT_PATTERNS
] + [
    "tools/" + p
    for p in COMMENT_LINT_PATTERNS
])
